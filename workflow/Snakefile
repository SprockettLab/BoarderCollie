# BoarderCollie workflow.
#
#   snakemake -s workflow/Snakefile --configfile config.yaml --cores 32
#
# Per genome: fetch, FCS-GX screen, cut flagged regions and draw controls,
# align them to the relative and the reference ladder, tandem repeats and
# copies, decide (boardercollie.rules), clean with gx clean-genome, check.
# settings: download_only skips everything after fetch; with the alignment
# checks (rules 3 to 5) all off, the alignment and repeat steps are skipped.
# Per host: join the cleaned genomes, build bowtie2 and minimap2 indexes.
# Every reference genome (relatives and ladder) is fetched and screened too,
# and is used only as a copy without every sequence FCS-GX reported in it.

import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
import re
from pathlib import Path

import yaml

from boardercollie import __version__
from boardercollie.config import parse_config, settings_hash
from boardercollie.references import resolve

CFG = parse_config(config)
LIB, IDX, WORK = CFG.library_dir, CFG.index_dir, CFG.work_dir
CHECKS = CFG.settings["checks"]
# download_only: genomes are fetched and joined as they are; nothing is screened or cleaned.
DOWNLOAD_ONLY = CFG.settings["download_only"]
# The alignment steps (and the relatives and ladder they align to) are needed only
# when at least one alignment-based check (rules 3 to 5) is on.
ALIGN = CHECKS["related_genome"] or CHECKS["lineage_repeat"] or CHECKS["repeat_family"]
if ALIGN:
    # Relatives and comparison genomes left blank in the config are chosen from the
    # NCBI taxonomy now, saved in the library with every candidate, and reused later.
    for _line in resolve(CFG, LIB):
        print("BoarderCollie reference choice:", _line, file=sys.stderr)
else:
    for _h in CFG.hosts:
        _h.ladder = []
        for _g in _h.genomes:
            _g.relative = None
print("BoarderCollie checks:", "download only" if DOWNLOAD_ONLY else
      ", ".join(f"{k} {'on' if v else 'off'}" for k, v in CHECKS.items()), file=sys.stderr)
SETTINGS_HASH = settings_hash(CFG.settings)

# Run log: one TSV row per step started and finished (with its exit status), plus
# rows for the run's start, tool versions and end. Rows are appended as the run goes.
RUN_LOG = WORK / "logs" / "run_log.tsv"
RUN_LOG.parent.mkdir(parents=True, exist_ok=True)
RUN_ID = os.environ.setdefault("BOARDERCOLLIE_RUN_ID", time.strftime("%Y%m%dT%H%M%S") + f"_{os.getpid()}")
RUN_LOG_COLUMNS = ("time", "run_id", "event", "step", "target", "exit_status", "detail")


def log_row(event, step="", target="", status="", detail=""):
    new = not RUN_LOG.exists()
    with open(RUN_LOG, "a") as fh:
        if new:
            fh.write("\t".join(RUN_LOG_COLUMNS) + "\n")
        row = (time.strftime("%Y-%m-%dT%H:%M:%S%z"), RUN_ID, event, step, target, str(status), detail)
        fh.write("\t".join(str(x).replace("\t", " ").replace("\n", " ") for x in row) + "\n")


def logged(step, cmd):
    """A rule's shell command with a run-log row before it and one after it (with the exit status).

    The command still stops at its first error; the row after it records that status
    and the step then fails as it would without the log.
    """
    row = (r"""printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" """
           + f'"{RUN_ID}" "$1" "{step}" "{{wildcards}}" "$2" "$3" >> "{RUN_LOG}"')
    return (f"_bclog() {{{{ {row}; }}}}\n_bclog start '' ''\nset +e\n( set -e\n{cmd}\n)\n"
            "_bcs=$?\nset -e\n_bclog finish \"$_bcs\" \"{output}\"\nexit $_bcs")


def tool_versions():
    cmds = {"snakemake": ["snakemake", "--version"], "minimap2": ["minimap2", "--version"],
            "bowtie2": ["bowtie2-build", "--version"], "trf": ["trf", "-v"],
            "fcs-gx": ["gx", "--help"], "python": [sys.executable, "--version"]}
    out = {}
    for name, cmd in cmds.items():
        if not shutil.which(cmd[0]):
            out[name] = "not found"
            continue
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
            text = (r.stdout or r.stderr).strip().splitlines()
            out[name] = next((l for l in text if any(c.isdigit() for c in l)), text[0] if text else "no output")[:200]
        except Exception as e:
            out[name] = f"error: {e}"
    return out


onstart:
    log_row("run_start", detail=json.dumps({
        "boardercollie": __version__, "configfile": [str(f) for f in workflow.configfiles],
        "settings_hash": SETTINGS_HASH, "download_only": CFG.settings["download_only"],
        "checks": CFG.settings["checks"], "fcs_gx_db": str(CFG.fcs_gx_db), "fcs_gx_build": GX,
        "hosts": {h.name: {"genomes": [g.key for g in h.genomes],
                           "relatives": {g.key: g.relative for g in h.genomes}, "ladder": h.ladder}
                  for h in CFG.hosts}}, sort_keys=True))
    for name, version in tool_versions().items():
        log_row("tool_version", step=name, detail=version)


onsuccess:
    log_row("run_finish", status=0, detail="all steps finished")


onerror:
    log_row("run_finish", status=1, detail=f"a step failed; Snakemake log: {log}")
RES = Path(workflow.basedir).parent / "resources"
# The config as used, saved once per run key set; every step reads this copy.
CONFIGFILE = WORK / "config.used.yaml"
CONFIGFILE.parent.mkdir(parents=True, exist_ok=True)
CONFIGFILE.write_text(yaml.safe_dump(config, sort_keys=True))


def db_build():
    """FCS-GX database build date: from the config if given, else from the database's all.meta.jsonl."""
    if DOWNLOAD_ONLY:
        return "not_screened"
    if CFG.fcs_gx_db_build:
        return CFG.fcs_gx_db_build
    meta = CFG.fcs_gx_db / "all.meta.jsonl"
    m = re.search(r'"build-date"\s*:\s*"([0-9-]+)"', meta.read_text()) if meta.exists() else None
    if not m:
        raise ValueError(f"cannot read the FCS-GX database build date from {meta}")
    return m.group(1)


GX = db_build()

# Genomes to clean, with their host settings; every accession to fetch and screen.
GENOMES = {}
for h in CFG.hosts:
    for g in h.genomes:
        GENOMES[g.key] = {"spec": g, "host": h}
REFERENCES = sorted(({g["spec"].relative for g in GENOMES.values()} - {None}) | {a for h in CFG.hosts for a in h.ladder})
ALL = sorted(set(GENOMES) | set(REFERENCES))


def run_key(acc):
    g = GENOMES[acc]
    text = json.dumps({"version": __version__, "gx": GX, "settings": SETTINGS_HASH,
                       "relative": g["spec"].relative, "ladder": g["host"].ladder}, sort_keys=True)
    return hashlib.sha256(text.encode()).hexdigest()[:12]


def host_key(h):
    return hashlib.sha256(json.dumps([run_key(g.key) for g in h.genomes]).encode()).hexdigest()[:12]


def G(acc):
    return LIB / "genomes" / acc


def RUN(acc):
    return G(acc) / "runs" / run_key(acc)


def member_files(acc):
    """The genome a host reference is built from, and its record: the cleaned genome, or the download."""
    if DOWNLOAD_ONLY:
        return G(acc) / "original" / f"{acc}.fna", G(acc) / "original" / "record.json"
    return RUN(acc) / f"{acc}_clean.fna", RUN(acc) / "run.json"


def W(acc):
    return WORK / acc / run_key(acc)


def lineage_candidates(acc):
    h = GENOMES[acc]["host"]
    return sorted(({GENOMES[acc]["spec"].relative} - {None}) | {g.key for g in h.genomes if g.key != acc})


HOSTS = {h.name: h for h in CFG.hosts}
TARGETS = []
for h in CFG.hosts:
    hk = host_key(h)
    TARGETS.append(LIB / "hosts" / h.name / hk / "members.tsv")
    TARGETS.append(LIB / "hosts" / h.name / hk / "contamination_report.tsv")
    if "bowtie2" in h.indexes:
        TARGETS.append(IDX / "bt2" / h.name / hk / "index_done.txt")
    if "minimap2" in h.indexes:
        TARGETS.append(IDX / "minimap2" / h.name / hk / f"{h.name}.map-ont.mmi")

wildcard_constraints:
    acc="[^/]+",
    ref=r"GC[AF]_[0-9]+\.[0-9]+",
    host="[^/]+",


rule all:
    input:
        TARGETS,


rule fetch:
    output:
        fasta=LIB / "genomes" / "{acc}" / "original" / "{acc}.fna",
        record=LIB / "genomes" / "{acc}" / "original" / "record.json",
    params:
        src=lambda w: (f"--local-fasta {GENOMES[w.acc]['spec'].fasta} --tax-id {GENOMES[w.acc]['spec'].tax_id}"
                       if w.acc in GENOMES and GENOMES[w.acc]["spec"].fasta else f"--accession {w.acc}"),
    resources:
        mem_mb=16000,
    shell:
        logged("fetch",
        "python -m boardercollie.cli fetch {params.src} --out-fasta {output.fasta} --out-record {output.record}")


rule screen:
    input:
        fasta=rules.fetch.output.fasta,
        record=rules.fetch.output.record,
    output:
        report=LIB / "genomes" / "{acc}" / "fcs_gx" / GX / "fcs_gx_report.txt",
        taxonomy=LIB / "genomes" / "{acc}" / "fcs_gx" / GX / "taxonomy.rpt",
        log=LIB / "genomes" / "{acc}" / "fcs_gx" / GX / "run_gx.log",
    params:
        db=CFG.fcs_gx_db,
        out=lambda w: LIB / "genomes" / w.acc / "fcs_gx" / GX,
    threads: 32
    resources:
        mem_mb=700000,
    shell:
        logged("screen",
        r"""
        # fcs_gx_db should point at a fast local copy of the database for the
        # whole run (see scripts/stage_fcs_gx_db.sh); it is read where it is.
        db={params.db}
        echo "FCS-GX database read from: $db" > {output.log}.stage
        taxid=$(python -m boardercollie.cli taxid {input.record})
        tmp={params.out}/tmp_$$; mkdir -p "$tmp"
        GX_NUM_CORES={threads} run_gx.py --fasta {input.fasta} --tax-id "$taxid" --gx-db "$db" --out-dir "$tmp" > {output.log} 2>&1
        mv "$tmp"/*.fcs_gx_report.txt {output.report}
        mv "$tmp"/*.taxonomy.rpt {output.taxonomy}
        rmdir "$tmp"
        """)


rule reference_without_flagged:
    input:
        fasta=rules.fetch.output.fasta,
        report=rules.screen.output.report,
        taxonomy=rules.screen.output.taxonomy,
    output:
        fasta=temp(WORK / "references" / GX / "{acc}.without_flagged.fna"),
        log=WORK / "references" / GX / "{acc}.without_flagged.log",
    shell:
        logged("reference_without_flagged",
        "python -m boardercollie.cli without-flagged --fasta {input.fasta} --report {input.report} "
        "--taxonomy {input.taxonomy} --out {output.fasta} --log {output.log}")


rule foreign_controls:
    input:
        RES / "foreign_controls.tsv",
    output:
        WORK / "foreign_controls.fna",
    shell:
        logged("foreign_controls",
        "python -m boardercollie.cli foreign-controls --tsv {input} --out {output}")


rule extract:
    input:
        fasta=rules.fetch.output.fasta,
        report=rules.screen.output.report,
        taxonomy=rules.screen.output.taxonomy,
    output:
        fasta=WORK / "{acc}" / "{key}" / "segments.fna",
        tsv=WORK / "{acc}" / "{key}" / "segments.tsv",
        composition=WORK / "{acc}" / "{key}" / "composition.tsv",
        fai=WORK / "{acc}" / "{key}" / "genome.fai",
    resources:
        mem_mb=8000,
    shell:
        logged("extract",
        "python -m boardercollie.cli extract --config {CONFIGFILE} --genome {input.fasta} --report {input.report} "
        "--taxonomy {input.taxonomy} --fai {output.fai} --out-fasta {output.fasta} --out-tsv {output.tsv} "
        "--out-composition {output.composition}")


rule queries:
    input:
        segments=rules.extract.output.fasta,
        foreign=rules.foreign_controls.output,
    output:
        WORK / "{acc}" / "{key}" / "queries.fna",
    shell:
        logged("queries",
        "cat {input.segments} {input.foreign} > {output}")


rule flagged:
    input:
        rules.extract.output.fasta,
    output:
        WORK / "{acc}" / "{key}" / "flagged.fna",
    shell:
        logged("flagged",
        r"""awk '/^>/ {{keep = ($0 ~ /^>R[0-9]+$/)}} keep' {input} > {output}""")


rule align:
    input:
        queries=rules.queries.output,
        ref=WORK / "references" / GX / "{ref}.without_flagged.fna",
    output:
        WORK / "{acc}" / "{key}" / "align" / "{ref}.paf",
    threads: 32
    resources:
        mem_mb=160000,
    shell:
        logged("align",
        "minimap2 -x asm20 -c --secondary=no -I 16G -t {threads} {input.ref} {input.queries} > {output} 2> {output}.log")


rule trf:
    input:
        rules.flagged.output,
    output:
        WORK / "{acc}" / "{key}" / "trf.ngs",
    shell:
        logged("trf",
        # No flagged regions: nothing to run. Otherwise TRF's exit status is not
        # usable (it is non-zero on success), so its log is checked for errors.
        r"""
        if [ ! -s {input} ]; then
          : > {output}; echo "no flagged regions" > {output}.log
        else
          (cd $(dirname {output}) && trf $(basename {input}) 2 7 7 80 10 50 2000 -h -ngs > trf.ngs 2> trf.ngs.log) || true
          if grep -qi "error" {output}.log; then cat {output}.log >&2; exit 1; fi
        fi
        """)


rule copies_own:
    input:
        flagged=rules.flagged.output,
        genome=rules.fetch.output.fasta,
    output:
        WORK / "{acc}" / "{key}" / "copies" / "own.paf",
    threads: 32
    resources:
        mem_mb=160000,
    params:
        n=200,
    shell:
        logged("copies_own",
        "minimap2 -x asm20 -c --secondary=yes -N {params.n} -p 0.3 -I 16G -t {threads} {input.genome} {input.flagged} > {output} 2> {output}.log")


rule copies_ref:
    input:
        flagged=rules.flagged.output,
        ref=WORK / "references" / GX / "{ref}.without_flagged.fna",
    output:
        WORK / "{acc}" / "{key}" / "copies" / "{ref}.paf",
    threads: 32
    resources:
        mem_mb=160000,
    params:
        n=200,
    shell:
        logged("copies_ref",
        "minimap2 -x asm20 -c --secondary=yes -N {params.n} -p 0.3 -I 16G -t {threads} {input.ref} {input.flagged} > {output} 2> {output}.log")


def decide_inputs(w):
    acc, key = w.acc, w.key
    g = GENOMES[acc]
    d = W(acc)
    refs = [r for r in [g["spec"].relative, *g["host"].ladder] if r]
    lineage = lineage_candidates(acc)
    distant = {"distant": d / "copies" / f"{g['host'].ladder[-1]}.paf"} if g["host"].ladder else {}
    common = {
        "segments": d / "segments.tsv",
        "fasta": d / "segments.fna",
        "composition": d / "composition.tsv",
        "foreign": WORK / "foreign_controls.fna",
        "record": G(acc) / "original" / "record.json",
    }
    if not ALIGN:
        return common
    return {**distant, **common,
        "align": [d / "align" / f"{r}.paf" for r in refs],
        "trf": d / "trf.ngs",
        "own": d / "copies" / "own.paf",
        "lineage": [d / "copies" / f"{r}.paf" for r in lineage],
        "lineage_records": [G(r) / "original" / "record.json" for r in lineage],
    }


def decide_args(w):
    g = GENOMES[w.acc]
    d = W(w.acc)
    rel, ladder = g["spec"].relative, g["host"].ladder
    if not ALIGN:
        return ""
    al = [f"--trf {d / 'trf.ngs'} --own-copies {d / 'copies' / 'own.paf'}"]
    al += [f"--alignment {rel}:relative:{d / 'align' / (rel + '.paf')}"] if rel else []
    al += [f"--alignment {r}:ladder:{d / 'align' / (r + '.paf')}" for r in ladder]
    if ladder:
        al.append(f"--distant-copies {d / 'copies' / (ladder[-1] + '.paf')}")
    if not rel:
        al.append("--test-unavailable no_relative")
    elif not ladder:
        al.append("--test-unavailable no_ladder")
    lin = " ".join(f"{r}={G(r) / 'original' / 'record.json'}={d / 'copies' / (r + '.paf')}" for r in lineage_candidates(w.acc))
    return " ".join(al) + (f" --lineage-copies {lin}" if lin else "")


rule decide:
    input:
        unpack(decide_inputs),
    output:
        decisions=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "decisions.tsv",
        removals=WORK / "{acc}" / "{key}" / "removals.tsv",
        lineage=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "lineage_assemblies.tsv",
        taxonomy=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "taxonomy_cache.json",
    params:
        args=decide_args,
    shell:
        logged("decide",
        "python -m boardercollie.cli decide --config {CONFIGFILE} --accession {wildcards.acc} "
        "--segments {input.segments} --segments-fasta {input.fasta} --composition {input.composition} "
        "--foreign {input.foreign} --own-record {input.record} "
        "--taxonomy-cache {output.taxonomy} --out-decisions {output.decisions} "
        "--out-removals {output.removals} --out-lineage {output.lineage} --settings-hash {SETTINGS_HASH} {params.args}")


rule clean:
    input:
        fasta=LIB / "genomes" / "{acc}" / "original" / "{acc}.fna",
        report=LIB / "genomes" / "{acc}" / "fcs_gx" / GX / "fcs_gx_report.txt",
        removals=rules.decide.output.removals,
        decisions=rules.decide.output.decisions,
    output:
        applied=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "applied_action_report.txt",
        clean=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "{acc}_clean.fna",
        removed=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "{acc}_removed.fna",
        record=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "run.json",
    params:
        gxlog=lambda w: LIB / "genomes" / w.acc / "runs" / w.key / "gx_clean_genome.log",
        fai=lambda w: WORK / w.acc / w.key / "genome.fai",
    resources:
        mem_mb=32000,
    shell:
        logged("clean",
        r"""
        python -m boardercollie.cli filter-report --report {input.report} --removals {input.removals} --out {output.applied}
        if grep -qv '^#' {output.applied}; then
          gx clean-genome --input={input.fasta} --action-report={output.applied} \
            --output={output.clean}.partial --contam-fasta-out={output.clean}.gx_contam.fna > {params.gxlog} 2>&1
          mv {output.clean}.partial {output.clean}
          rm -f {output.clean}.gx_contam.fna
          gxlog="--gx-log {params.gxlog}"
        else
          cp {input.fasta} {output.clean}; gxlog=""
        fi
        # The removed FASTA is cut from the original by BoarderCollie, so it holds every removed region.
        python -m boardercollie.cli check-clean --accession {wildcards.acc} --original {input.fasta} \
          --clean {output.clean} --removed {output.removed} --removals {input.removals} --fai {params.fai} $gxlog \
          --decisions {input.decisions} --run-key {wildcards.key} --settings-hash {SETTINGS_HASH} --out {output.record}
        """)


rule combine:
    input:
        clean=lambda w: [member_files(g.key)[0] for g in HOSTS[w.host].genomes],
        records=lambda w: [member_files(g.key)[1] for g in HOSTS[w.host].genomes],
    output:
        fasta=LIB / "hosts" / "{host}" / "{hkey}" / "{host}.fna",
        members=LIB / "hosts" / "{host}" / "{hkey}" / "members.tsv",
    params:
        accs=lambda w: " ".join(g.key for g in HOSTS[w.host].genomes),
    shell:
        logged("combine",
        "python -m boardercollie.cli combine --accessions {params.accs} --fastas {input.clean} "
        "--records {input.records} --out {output.fasta} --members-out {output.members}")


def report_spec(acc):
    g = GENOMES[acc]
    rel, ladder = g["spec"].relative, g["host"].ladder
    if DOWNLOAD_ONLY:
        dec, run = "-", G(acc) / "original" / "record.json"
    else:
        dec, run = RUN(acc) / "decisions.tsv", RUN(acc) / "run.json"
    return f"'{acc}|{dec}|{run}|{G(acc) / 'original' / 'record.json'}|{rel or '-'}|{','.join(ladder) or '-'}'"


rule report:
    input:
        members=rules.combine.output.members,
    output:
        regions=LIB / "hosts" / "{host}" / "{hkey}" / "contamination_report.tsv",
        genomes=LIB / "hosts" / "{host}" / "{hkey}" / "genome_summary.tsv",
    params:
        genomes=lambda w: " ".join(f"--genome {report_spec(g.key)}" for g in HOSTS[w.host].genomes),
    shell:
        logged("report",
        "python -m boardercollie.cli report --host {wildcards.host} {params.genomes} "
        "--out-regions {output.regions} --out-genomes {output.genomes}")


rule bowtie2:
    input:
        rules.combine.output.fasta,
    output:
        IDX / "bt2" / "{host}" / "{hkey}" / "index_done.txt",
    threads: 32
    resources:
        mem_mb=300000,
    shell:
        logged("bowtie2",
        r"""
        d=$(dirname {output})
        bowtie2-build --large-index --threads {threads} {input} "$d/{wildcards.host}" > "$d/build.log" 2>&1
        for p in 1 2 3 4 rev.1 rev.2; do test -s "$d/{wildcards.host}.$p.bt2l"; done
        echo "bowtie2 index of {input} built $(date -Is) with $(bowtie2-build --version | head -n 1)" > {output}
        """)


rule minimap2_index:
    input:
        rules.combine.output.fasta,
    output:
        IDX / "minimap2" / "{host}" / "{hkey}" / "{host}.map-ont.mmi",
    threads: 16
    resources:
        mem_mb=120000,
    shell:
        logged("minimap2_index",
        "minimap2 -x map-ont -I 16G -t {threads} -d {output} {input} 2> {output}.log")
