# BoarderCollie workflow.
#
#   snakemake -s workflow/Snakefile --configfile config.yaml --cores 32
#
# Per genome: fetch, FCS-GX screen, cut flagged regions and draw controls,
# align them to the relative and the reference ladder, tandem repeats and
# copies, decide (boardercollie.rules), clean with gx clean-genome, check.
# settings: download_only skips everything after fetch; with the alignment
# checks (rules 3 to 5) all off, the alignment and repeat steps are skipped.
# Per host: join the cleaned genomes; build the bowtie2 and minimap2 indexes listed in
# the host's indexes (none by default).
# Every reference genome (relatives and ladder) is fetched and screened too,
# and is used only as a copy without every sequence FCS-GX reported in it.

import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
import re
from pathlib import Path

import yaml

# The repository this Snakefile belongs to. The boardercollie package is taken from
# here, both when the workflow is read and in every step, so it need not be installed
# in any conda environment (including a calling workflow's, e.g. MAGmaker's).
# Steps cannot rely on PYTHONPATH set here: with --use-conda, Snakemake runs each step
# with PYTHONPATH removed. BOARDERCOLLIE_REPO is passed through untouched, and logged()
# puts it on PYTHONPATH at the start of every step.
REPO = Path(workflow.current_basedir).parent.resolve()
if str(REPO) not in sys.path:
    sys.path.insert(0, str(REPO))
os.environ["BOARDERCOLLIE_REPO"] = str(REPO)
os.environ["PYTHONPATH"] = os.pathsep.join([str(REPO)] + [p for p in os.environ.get("PYTHONPATH", "").split(os.pathsep)
                                                           if p and p != str(REPO)])

from boardercollie import __version__
from boardercollie.config import parse_config, settings_hash, write_if_changed
from boardercollie.controls import up_to_date as controls_up_to_date
from boardercollie.precomputed import build_date, find_reports, reports_hash
from boardercollie.references import resolve

CFG = parse_config(config)
LIB, IDX, WORK = CFG.library_dir, CFG.index_dir, CFG.work_dir
CHECKS = CFG.settings["checks"]
# download_only: genomes are fetched and joined as they are; nothing is screened or cleaned.
DOWNLOAD_ONLY = CFG.settings["download_only"]
# The alignment steps (and the relatives and ladder they align to) are needed only
# when at least one alignment-based check (rules 3 to 5) is on.
ALIGN = CHECKS["related_genome"] or CHECKS["lineage_repeat"] or CHECKS["repeat_family"]
if ALIGN:
    # Relatives and comparison genomes left blank in the config are chosen from the
    # NCBI taxonomy now, saved in the library with every candidate, and reused later.
    for _line in resolve(CFG, LIB):
        print("BoarderCollie reference choice:", _line, file=sys.stderr)
else:
    for _h in CFG.hosts:
        _h.ladder = []
        for _g in _h.genomes:
            _g.relative = None
print("BoarderCollie checks:", "download only" if DOWNLOAD_ONLY else
      ", ".join(f"{k} {'on' if v else 'off'}" for k, v in CHECKS.items()), file=sys.stderr)
SETTINGS_HASH = settings_hash(CFG.settings)

# Run log: one TSV row per step started and finished (with its exit status), plus
# rows for the run's start, tool versions and end. Rows are appended as the run goes.
RUN_LOG = WORK / "logs" / "run_log.tsv"
RUN_LOG.parent.mkdir(parents=True, exist_ok=True)
RUN_ID = os.environ.setdefault("BOARDERCOLLIE_RUN_ID", time.strftime("%Y%m%dT%H%M%S") + f"_{os.getpid()}")
RUN_LOG_COLUMNS = ("time", "run_id", "event", "step", "target", "exit_status", "detail")


def log_row(event, step="", target="", status="", detail=""):
    new = not RUN_LOG.exists()
    with open(RUN_LOG, "a") as fh:
        if new:
            fh.write("\t".join(RUN_LOG_COLUMNS) + "\n")
        row = (time.strftime("%Y-%m-%dT%H:%M:%S%z"), RUN_ID, event, step, target, str(status), detail)
        fh.write("\t".join(str(x).replace("\t", " ").replace("\n", " ") for x in row) + "\n")


def logged(step, cmd):
    """A rule's shell command with a run-log row before it and one after it (with the exit status).

    The command still stops at its first error; the row after it records that status
    and the step then fails as it would without the log.
    The run id is read from the environment when the step runs, never written into the
    command: Snakemake reruns a finished step whose command text has changed, so a run id
    in the text would make every new run redo every step, FCS-GX screens included.
    The package's folder comes the same way, from BOARDERCOLLIE_REPO (see REPO above),
    so the command text does not depend on where BoarderCollie is cloned.
    """
    row = (r"""printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" """
           + f'"${{{{BOARDERCOLLIE_RUN_ID:-unknown}}}}" "$1" "{step}" "{{wildcards}}" "$2" "$3" >> "{RUN_LOG}"')
    path = ('export PYTHONPATH="${{BOARDERCOLLIE_REPO:?BOARDERCOLLIE_REPO is not set}}'
            '${{PYTHONPATH:+:$PYTHONPATH}}"\n')
    return (path + f"_bclog() {{{{ {row}; }}}}\n_bclog start '' ''\nset +e\n( set -e\n{cmd}\n)\n"
            "_bcs=$?\nset -e\n_bclog finish \"$_bcs\" \"{output}\"\nexit $_bcs")


def tool_versions():
    cmds = {"snakemake": ["snakemake", "--version"], "minimap2": ["minimap2", "--version"],
            "bowtie2": ["bowtie2-build", "--version"], "trf": ["trf", "-v"],
            "fcs-gx": ["gx", "--help"], "python": [sys.executable, "--version"]}
    out = {}
    for name, cmd in cmds.items():
        if not shutil.which(cmd[0]):
            out[name] = "not found"
            continue
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
            text = (r.stdout or r.stderr).strip().splitlines()
            out[name] = next((l for l in text if any(c.isdigit() for c in l)), text[0] if text else "no output")[:200]
        except Exception as e:
            out[name] = f"error: {e}"
    return out


onstart:
    log_row("run_start", detail=json.dumps({
        "boardercollie": __version__, "configfile": [str(f) for f in workflow.configfiles],
        "settings_hash": SETTINGS_HASH, "download_only": CFG.settings["download_only"],
        "checks": CFG.settings["checks"], "fcs_gx_db": str(CFG.fcs_gx_db), "fcs_gx_build": GX,
        "fcs_gx_reports_made_earlier": {a: [str(p) for p in pair] for a, pair in PRECOMPUTED.items()},
        "hosts": {h.name: {"genomes": [g.key for g in h.genomes],
                           "relatives": {g.key: g.relative for g in h.genomes}, "ladder": h.ladder}
                  for h in CFG.hosts}}, sort_keys=True))
    for name, version in tool_versions().items():
        log_row("tool_version", step=name, detail=version)


onsuccess:
    log_row("run_finish", status=0, detail="all steps finished")


onerror:
    log_row("run_finish", status=1, detail=f"a step failed; Snakemake log: {log}")
RES = REPO / "resources"
# The config as used; every step reads this copy. The workflow is read again by every
# cluster job (a calling workflow's jobs too), so the file is written only when its
# contents change, and then whole (written beside it and renamed): a step reading it
# never sees it half written.
CONFIGFILE = WORK / "config.used.yaml"
write_if_changed(CONFIGFILE, yaml.safe_dump(config, sort_keys=True))


# Genomes to clean, with their host settings; every accession to fetch and screen.
GENOMES = {}
for h in CFG.hosts:
    for g in h.genomes:
        GENOMES[g.key] = {"spec": g, "host": h}
REFERENCES = sorted(({g["spec"].relative for g in GENOMES.values()} - {None}) | {a for h in CFG.hosts for a in h.ladder})
ALL = sorted(set(GENOMES) | set(REFERENCES))

# FCS-GX reports made earlier (fcs_gx_reports): genomes with a report pair there are
# not screened; the pair is checked against the genome and copied into the library.
PRECOMPUTED = {}
if not DOWNLOAD_ONLY and CFG.fcs_gx_reports:
    if not CFG.fcs_gx_reports.is_dir():
        raise ValueError(f"fcs_gx_reports: {CFG.fcs_gx_reports} is not a folder")
    for _acc in ALL:
        _pair = find_reports(CFG.fcs_gx_reports, _acc)
        if _pair:
            PRECOMPUTED[_acc] = _pair
PHASH = {acc: reports_hash(*pair) for acc, pair in PRECOMPUTED.items()}
TO_SCREEN = [] if DOWNLOAD_ONLY else [a for a in ALL if a not in PRECOMPUTED]
if TO_SCREEN and not CFG.fcs_gx_db:
    raise ValueError(f"no FCS-GX database (fcs_gx_db) is given and {CFG.fcs_gx_reports} has no reports for: "
                     + ", ".join(TO_SCREEN))


def db_build():
    """FCS-GX database build date: from the config if given, else from the database's
    all.meta.jsonl, else from the headers of the reports made earlier. Every report made
    earlier must name the same build, when its header names one."""
    if DOWNLOAD_ONLY:
        return "not_screened"
    stated = {acc: build_date(*pair) for acc, pair in PRECOMPUTED.items()}
    builds = set(stated.values()) - {None}
    if CFG.fcs_gx_db_build:
        gx = CFG.fcs_gx_db_build
    elif TO_SCREEN:
        meta = CFG.fcs_gx_db / "all.meta.jsonl"
        m = re.search(r'"build-date"\s*:\s*"([0-9-]+)"', meta.read_text()) if meta.exists() else None
        if not m:
            raise ValueError(f"cannot read the FCS-GX database build date from {meta}")
        gx = m.group(1)
    elif len(builds) == 1:
        gx = builds.pop()
        builds = {gx}
    else:
        raise ValueError("the FCS-GX reports made earlier do not state one database build "
                         f"({sorted(builds) or 'none stated'}); give it as fcs_gx_db_build")
    other = {acc: b for acc, b in stated.items() if b is not None and b != gx}
    if other:
        raise ValueError(f"FCS-GX reports made with a different database build than {gx}: {other}")
    return gx


GX = db_build()
if PRECOMPUTED:
    print(f"BoarderCollie: FCS-GX reports made earlier are used for {len(PRECOMPUTED)} of {len(ALL)} genomes:",
          ", ".join(sorted(PRECOMPUTED)), file=sys.stderr)


def screen_files(acc):
    """The FCS-GX action and taxonomy reports a genome is tested with."""
    d = G(acc) / "fcs_gx" / ("precomputed/" + PHASH[acc] if acc in PRECOMPUTED else GX)
    return {"report": d / "fcs_gx_report.txt", "taxonomy": d / "taxonomy.rpt"}


def run_key(acc):
    g = GENOMES[acc]
    key = {"version": __version__, "gx": GX, "settings": SETTINGS_HASH,
           "relative": g["spec"].relative, "ladder": g["host"].ladder}
    # Reports made earlier (for the genome or its references) are part of the key, so
    # results from them never mix with results from FCS-GX run here.
    used = {a: PHASH[a] for a in [acc, g["spec"].relative, *g["host"].ladder] if a in PRECOMPUTED}
    if used:
        key["precomputed_reports"] = used
    return hashlib.sha256(json.dumps(key, sort_keys=True).encode()).hexdigest()[:12]


def host_key(h):
    # The genomes are named in the key: a run key leaves out the genome (its folder
    # names it), so two hosts with different genomes and the same settings would
    # otherwise share a key, and a changed genome list would overwrite the old reference.
    # A genome's mitochondrion is named too, only when it has one, so the key of a
    # host without one is what it was before mitochondria could be added.
    return hashlib.sha256(json.dumps([[g.key, run_key(g.key)] + (["mitochondrion", g.mitochondrion]
                                                                  if g.mitochondrion else [])
                                      for g in h.genomes]).encode()).hexdigest()[:12]


def G(acc):
    return LIB / "genomes" / acc


def RUN(acc):
    return G(acc) / "runs" / run_key(acc)


def member_files(acc):
    """The genome a host reference is built from, and its record: the cleaned genome, or the download."""
    if DOWNLOAD_ONLY:
        return G(acc) / "original" / f"{acc}.fna", G(acc) / "original" / "record.json"
    return RUN(acc) / f"{acc}_clean.fna", RUN(acc) / "run.json"


def mitochondrion_files(acc, mito):
    """A genome's mitochondrion and its record. Taken from the host's own genome entry, not
    from GENOMES: one assembly can serve two hosts, and only one of them may name one."""
    d = G(acc) / "mitochondrion" / mito
    return d / f"{mito}.fna", d / "record.json"


def host_members(h):
    """(accession, FASTA, record, member_of) of everything joined into a host reference, in
    order: each genome, then its mitochondrion when it names one."""
    out = []
    for g in h.genomes:
        fasta, record = member_files(g.key)
        out.append((g.key, fasta, record, "-"))
        if g.mitochondrion:
            mf, mr = mitochondrion_files(g.key, g.mitochondrion)
            out.append((g.mitochondrion, mf, mr, g.key))
    return out


def W(acc):
    return WORK / acc / run_key(acc)


def lineage_candidates(acc):
    h = GENOMES[acc]["host"]
    return sorted(({GENOMES[acc]["spec"].relative} - {None}) | {g.key for g in h.genomes if g.key != acc})


HOSTS = {h.name: h for h in CFG.hosts}
TARGETS = []
for h in CFG.hosts:
    hk = host_key(h)
    TARGETS.append(LIB / "hosts" / h.name / hk / "members.tsv")
    TARGETS.append(LIB / "hosts" / h.name / hk / "contamination_report.tsv")
    if "bowtie2" in h.indexes:
        TARGETS.append(IDX / "bt2" / h.name / hk / "index_done.txt")
    if "minimap2" in h.indexes:
        TARGETS.append(IDX / "minimap2" / h.name / hk / f"{h.name}.map-ont.mmi")
    if h.reference_out:
        TARGETS.append(h.reference_out)
    if h.bowtie2_out:
        TARGETS.append(h.bowtie2_out + ".index_done.txt")
    if h.minimap2_out:
        TARGETS.append(h.minimap2_out)

wildcard_constraints:
    acc="[^/]+",
    macc=r"[A-Z]{1,4}_?[0-9]{5,10}\.[0-9]+",
    ref=r"GC[AF]_[0-9]+\.[0-9]+",
    host="[^/]+",
    phash="[0-9a-f]{12}",


rule all:
    input:
        TARGETS,


def fetch_input(w):
    """A local FASTA is an input of its fetch step, so a file replaced at the same path
    (newer than the library copy) is copied again; an accession has no input."""
    spec = GENOMES[w.acc]["spec"] if w.acc in GENOMES else None
    return [spec.fasta] if spec and spec.fasta else []


rule fetch:
    conda:
        "envs/boardercollie.yaml"
    input:
        fetch_input,
    output:
        fasta=LIB / "genomes" / "{acc}" / "original" / "{acc}.fna",
        record=LIB / "genomes" / "{acc}" / "original" / "record.json",
    params:
        src=lambda w: (f"--local-fasta {GENOMES[w.acc]['spec'].fasta} --tax-id {GENOMES[w.acc]['spec'].tax_id}"
                       if w.acc in GENOMES and GENOMES[w.acc]["spec"].fasta else f"--accession {w.acc}"),
    resources:
        mem_mb=16000,
    shell:
        logged("fetch",
        "python -m boardercollie.cli fetch {params.src} --out-fasta {output.fasta} --out-record {output.record}")


rule fetch_mitochondrion:
    # The genome's own species' mitochondrial genome from NCBI Nucleotide, checked
    # (boardercollie.mitochondrion) and added to the host reference after the genome.
    conda:
        "envs/boardercollie.yaml"
    input:
        genome_record=LIB / "genomes" / "{acc}" / "original" / "record.json",
    output:
        fasta=LIB / "genomes" / "{acc}" / "mitochondrion" / "{macc}" / "{macc}.fna",
        record=LIB / "genomes" / "{acc}" / "mitochondrion" / "{macc}" / "record.json",
    shell:
        logged("fetch_mitochondrion",
        "python -m boardercollie.cli fetch-mitochondrion --accession {wildcards.macc} --genome {wildcards.acc} "
        "--genome-record {input.genome_record} --out-fasta {output.fasta} --out-record {output.record}")


rule screen:
    conda:
        "envs/boardercollie.yaml"
    input:
        fasta=rules.fetch.output.fasta,
        record=rules.fetch.output.record,
    output:
        report=LIB / "genomes" / "{acc}" / "fcs_gx" / GX / "fcs_gx_report.txt",
        taxonomy=LIB / "genomes" / "{acc}" / "fcs_gx" / GX / "taxonomy.rpt",
        log=LIB / "genomes" / "{acc}" / "fcs_gx" / GX / "run_gx.log",
    params:
        db=CFG.fcs_gx_db,
        out=lambda w: LIB / "genomes" / w.acc / "fcs_gx" / GX,
    threads: 32
    resources:
        mem_mb=700000,
    shell:
        logged("screen",
        r"""
        # fcs_gx_db should point at a fast local copy of the database for the
        # whole run (see scripts/stage_fcs_gx_db.sh); it is read where it is.
        db={params.db}
        echo "FCS-GX database read from: $db" > {output.log}.stage
        taxid=$(python -m boardercollie.cli taxid {input.record})
        tmp={params.out}/tmp_$$; mkdir -p "$tmp"
        GX_NUM_CORES={threads} run_gx.py --fasta {input.fasta} --tax-id "$taxid" --gx-db "$db" --out-dir "$tmp" > {output.log} 2>&1
        mv "$tmp"/*.fcs_gx_report.txt {output.report}
        mv "$tmp"/*.taxonomy.rpt {output.taxonomy}
        rmdir "$tmp"
        """)


rule screen_precomputed:
    conda:
        "envs/boardercollie.yaml"
    input:
        fasta=rules.fetch.output.fasta,
        record=rules.fetch.output.record,
        action=lambda w: PRECOMPUTED[w.acc][0],
        taxonomy=lambda w: PRECOMPUTED[w.acc][1],
    output:
        report=LIB / "genomes" / "{acc}" / "fcs_gx" / "precomputed" / "{phash}" / "fcs_gx_report.txt",
        taxonomy=LIB / "genomes" / "{acc}" / "fcs_gx" / "precomputed" / "{phash}" / "taxonomy.rpt",
        record=LIB / "genomes" / "{acc}" / "fcs_gx" / "precomputed" / "{phash}" / "check.json",
    params:
        build=GX,
    resources:
        mem_mb=8000,
    shell:
        logged("screen_precomputed",
        "python -m boardercollie.cli import-fcs-reports --fasta {input.fasta} --record {input.record} "
        "--action {input.action} --taxonomy {input.taxonomy} --build {params.build} "
        "--out-report {output.report} --out-taxonomy {output.taxonomy} --out-record {output.record}")


rule reference_without_flagged:
    conda:
        "envs/boardercollie.yaml"
    input:
        fasta=rules.fetch.output.fasta,
        report=lambda w: screen_files(w.acc)["report"],
        taxonomy=lambda w: screen_files(w.acc)["taxonomy"],
    output:
        fasta=temp(WORK / "references" / GX / "{acc}.without_flagged.fna"),
        log=WORK / "references" / GX / "{acc}.without_flagged.log",
    shell:
        logged("reference_without_flagged",
        "python -m boardercollie.cli without-flagged --fasta {input.fasta} --report {input.report} "
        "--taxonomy {input.taxonomy} --out {output.fasta} --log {output.log}")


rule foreign_controls:
    conda:
        "envs/boardercollie.yaml"
    # The table is in BoarderCollie's own folder, and each caller (each MAGmaker run
    # folder) has a fresh clone of it, so its mtime is the clone's. When the shared
    # FASTA already holds exactly the listed accessions, that mtime is ignored
    # (ancient); otherwise the controls are fetched again, so a changed list is never
    # missed. Without this, every new caller redid align, decide, clean and combine.
    input:
        ancient(RES / "foreign_controls.tsv")
        if controls_up_to_date(RES / "foreign_controls.tsv", WORK / "foreign_controls.fna")
        else RES / "foreign_controls.tsv",
    output:
        WORK / "foreign_controls.fna",
    shell:
        logged("foreign_controls",
        "python -m boardercollie.cli foreign-controls --tsv {input} --out {output}")


rule extract:
    conda:
        "envs/boardercollie.yaml"
    input:
        fasta=rules.fetch.output.fasta,
        report=lambda w: screen_files(w.acc)["report"],
        taxonomy=lambda w: screen_files(w.acc)["taxonomy"],
    output:
        fasta=WORK / "{acc}" / "{key}" / "segments.fna",
        tsv=WORK / "{acc}" / "{key}" / "segments.tsv",
        composition=WORK / "{acc}" / "{key}" / "composition.tsv",
        fai=WORK / "{acc}" / "{key}" / "genome.fai",
    params:
        config=CONFIGFILE,
    resources:
        mem_mb=8000,
    shell:
        logged("extract",
        "python -m boardercollie.cli extract --config {params.config} --genome {input.fasta} --report {input.report} "
        "--taxonomy {input.taxonomy} --fai {output.fai} --out-fasta {output.fasta} --out-tsv {output.tsv} "
        "--out-composition {output.composition}")


rule queries:
    conda:
        "envs/boardercollie.yaml"
    input:
        segments=rules.extract.output.fasta,
        foreign=rules.foreign_controls.output,
    output:
        WORK / "{acc}" / "{key}" / "queries.fna",
    shell:
        logged("queries",
        "cat {input.segments} {input.foreign} > {output}")


rule flagged:
    conda:
        "envs/boardercollie.yaml"
    input:
        rules.extract.output.fasta,
    output:
        WORK / "{acc}" / "{key}" / "flagged.fna",
    shell:
        logged("flagged",
        r"""awk '/^>/ {{keep = ($0 ~ /^>R[0-9]+$/)}} keep' {input} > {output}""")


rule align:
    conda:
        "envs/boardercollie.yaml"
    input:
        queries=rules.queries.output,
        ref=WORK / "references" / GX / "{ref}.without_flagged.fna",
    output:
        WORK / "{acc}" / "{key}" / "align" / "{ref}.paf",
    threads: 32
    resources:
        mem_mb=160000,
    shell:
        logged("align",
        "minimap2 -x asm20 -c --secondary=no -I 16G -t {threads} {input.ref} {input.queries} > {output} 2> {output}.log")


rule trf:
    conda:
        "envs/boardercollie.yaml"
    input:
        rules.flagged.output,
    output:
        WORK / "{acc}" / "{key}" / "trf.ngs",
    shell:
        logged("trf",
        # No flagged regions: nothing to run. Otherwise TRF's exit status is not
        # usable (it is non-zero on success), so its log is checked for errors.
        r"""
        if [ ! -s {input} ]; then
          : > {output}; echo "no flagged regions" > {output}.log
        else
          (cd $(dirname {output}) && trf $(basename {input}) 2 7 7 80 10 50 2000 -h -ngs > trf.ngs 2> trf.ngs.log) || true
          if grep -qi "error" {output}.log; then cat {output}.log >&2; exit 1; fi
        fi
        """)


rule copies_own:
    conda:
        "envs/boardercollie.yaml"
    input:
        flagged=rules.flagged.output,
        genome=rules.fetch.output.fasta,
    output:
        WORK / "{acc}" / "{key}" / "copies" / "own.paf",
    threads: 32
    resources:
        mem_mb=160000,
    params:
        n=200,
    shell:
        logged("copies_own",
        "minimap2 -x asm20 -c --secondary=yes -N {params.n} -p 0.3 -I 16G -t {threads} {input.genome} {input.flagged} > {output} 2> {output}.log")


rule copies_ref:
    conda:
        "envs/boardercollie.yaml"
    input:
        flagged=rules.flagged.output,
        ref=WORK / "references" / GX / "{ref}.without_flagged.fna",
    output:
        WORK / "{acc}" / "{key}" / "copies" / "{ref}.paf",
    threads: 32
    resources:
        mem_mb=160000,
    params:
        n=200,
    shell:
        logged("copies_ref",
        "minimap2 -x asm20 -c --secondary=yes -N {params.n} -p 0.3 -I 16G -t {threads} {input.ref} {input.flagged} > {output} 2> {output}.log")


def decide_inputs(w):
    acc, key = w.acc, w.key
    g = GENOMES[acc]
    d = W(acc)
    refs = [r for r in [g["spec"].relative, *g["host"].ladder] if r]
    lineage = lineage_candidates(acc)
    distant = {"distant": d / "copies" / f"{g['host'].ladder[-1]}.paf"} if g["host"].ladder else {}
    common = {
        "segments": d / "segments.tsv",
        "fasta": d / "segments.fna",
        "composition": d / "composition.tsv",
        "foreign": WORK / "foreign_controls.fna",
        "record": G(acc) / "original" / "record.json",
    }
    if not ALIGN:
        return common
    return {**distant, **common,
        "align": [d / "align" / f"{r}.paf" for r in refs],
        "trf": d / "trf.ngs",
        "own": d / "copies" / "own.paf",
        "lineage": [d / "copies" / f"{r}.paf" for r in lineage],
        "lineage_records": [G(r) / "original" / "record.json" for r in lineage],
    }


def decide_args(w):
    g = GENOMES[w.acc]
    d = W(w.acc)
    rel, ladder = g["spec"].relative, g["host"].ladder
    if not ALIGN:
        return ""
    al = [f"--trf {d / 'trf.ngs'} --own-copies {d / 'copies' / 'own.paf'}"]
    al += [f"--alignment {rel}:relative:{d / 'align' / (rel + '.paf')}"] if rel else []
    al += [f"--alignment {r}:ladder:{d / 'align' / (r + '.paf')}" for r in ladder]
    if ladder:
        al.append(f"--distant-copies {d / 'copies' / (ladder[-1] + '.paf')}")
    if not rel:
        al.append("--test-unavailable no_relative")
    elif not ladder:
        al.append("--test-unavailable no_ladder")
    lin = " ".join(f"{r}={G(r) / 'original' / 'record.json'}={d / 'copies' / (r + '.paf')}" for r in lineage_candidates(w.acc))
    return " ".join(al) + (f" --lineage-copies {lin}" if lin else "")


rule decide:
    conda:
        "envs/boardercollie.yaml"
    input:
        unpack(decide_inputs),
    output:
        decisions=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "decisions.tsv",
        removals=WORK / "{acc}" / "{key}" / "removals.tsv",
        lineage=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "lineage_assemblies.tsv",
        taxonomy=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "taxonomy_cache.json",
    params:
        args=decide_args,
        config=CONFIGFILE,
        settings_hash=SETTINGS_HASH,
    shell:
        logged("decide",
        "python -m boardercollie.cli decide --config {params.config} --accession {wildcards.acc} "
        "--segments {input.segments} --segments-fasta {input.fasta} --composition {input.composition} "
        "--foreign {input.foreign} --own-record {input.record} "
        "--taxonomy-cache {output.taxonomy} --out-decisions {output.decisions} "
        "--out-removals {output.removals} --out-lineage {output.lineage} --settings-hash {params.settings_hash} {params.args}")


rule clean:
    conda:
        "envs/boardercollie.yaml"
    input:
        fasta=LIB / "genomes" / "{acc}" / "original" / "{acc}.fna",
        report=lambda w: screen_files(w.acc)["report"],
        removals=rules.decide.output.removals,
        decisions=rules.decide.output.decisions,
    output:
        applied=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "applied_action_report.txt",
        clean=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "{acc}_clean.fna",
        removed=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "{acc}_removed.fna",
        record=LIB / "genomes" / "{acc}" / "runs" / "{key}" / "run.json",
    params:
        gxlog=lambda w: LIB / "genomes" / w.acc / "runs" / w.key / "gx_clean_genome.log",
        fai=lambda w: WORK / w.acc / w.key / "genome.fai",
        settings_hash=SETTINGS_HASH,
    resources:
        mem_mb=32000,
    shell:
        logged("clean",
        r"""
        python -m boardercollie.cli filter-report --report {input.report} --removals {input.removals} --out {output.applied}
        if grep -qv '^#' {output.applied}; then
          gx clean-genome --input={input.fasta} --action-report={output.applied} \
            --output={output.clean}.partial --contam-fasta-out={output.clean}.gx_contam.fna > {params.gxlog} 2>&1
          mv {output.clean}.partial {output.clean}
          rm -f {output.clean}.gx_contam.fna
          gxlog="--gx-log {params.gxlog}"
        else
          cp {input.fasta} {output.clean}; gxlog=""
        fi
        # The removed FASTA is cut from the original by BoarderCollie, so it holds every removed region.
        python -m boardercollie.cli check-clean --accession {wildcards.acc} --original {input.fasta} \
          --clean {output.clean} --removed {output.removed} --removals {input.removals} --fai {params.fai} $gxlog \
          --decisions {input.decisions} --run-key {wildcards.key} --settings-hash {params.settings_hash} --out {output.record}
        """)


rule combine:
    conda:
        "envs/boardercollie.yaml"
    input:
        clean=lambda w: [m[1] for m in host_members(HOSTS[w.host])],
        records=lambda w: [m[2] for m in host_members(HOSTS[w.host])],
    output:
        fasta=LIB / "hosts" / "{host}" / "{hkey}" / "{host}.fna",
        members=LIB / "hosts" / "{host}" / "{hkey}" / "members.tsv",
    params:
        accs=lambda w: " ".join(m[0] for m in host_members(HOSTS[w.host])),
        member_of=lambda w: " ".join(m[3] for m in host_members(HOSTS[w.host])),
    shell:
        logged("combine",
        "python -m boardercollie.cli combine --accessions {params.accs} --fastas {input.clean} "
        "--records {input.records} --member-of {params.member_of} --out {output.fasta} "
        "--members-out {output.members}")


def report_spec(acc):
    g = GENOMES[acc]
    rel, ladder = g["spec"].relative, g["host"].ladder
    if DOWNLOAD_ONLY:
        dec, run = "-", G(acc) / "original" / "record.json"
    else:
        dec, run = RUN(acc) / "decisions.tsv", RUN(acc) / "run.json"
    if DOWNLOAD_ONLY:
        screen = "-"
    elif acc in PRECOMPUTED:
        screen = f"precomputed:{G(acc) / 'fcs_gx' / 'precomputed' / PHASH[acc] / 'check.json'}"
    else:
        screen = f"run:{GX}"
    return (f"'{acc}|{dec}|{run}|{G(acc) / 'original' / 'record.json'}|{rel or '-'}|{','.join(ladder) or '-'}"
            f"|{screen}'")


rule report:
    conda:
        "envs/boardercollie.yaml"
    input:
        members=rules.combine.output.members,
        checks=lambda w: [G(g.key) / "fcs_gx" / "precomputed" / PHASH[g.key] / "check.json"
                          for g in HOSTS[w.host].genomes if g.key in PRECOMPUTED],
    output:
        regions=LIB / "hosts" / "{host}" / "{hkey}" / "contamination_report.tsv",
        genomes=LIB / "hosts" / "{host}" / "{hkey}" / "genome_summary.tsv",
    params:
        genomes=lambda w: " ".join(f"--genome {report_spec(g.key)}" for g in HOSTS[w.host].genomes),
    shell:
        logged("report",
        "python -m boardercollie.cli report --host {wildcards.host} {params.genomes} "
        "--out-regions {output.regions} --out-genomes {output.genomes}")


rule bowtie2:
    conda:
        "envs/boardercollie.yaml"
    # ancient: a caller's reference_out is a hard link of this FASTA, and Snakemake
    # touches every output after a job, so each caller run bumps this file's mtime.
    # The index belongs to the host key (genomes and settings), not to that mtime;
    # without ancient every later caller would rebuild the shared index. A rerun of
    # combine itself still reruns this step.
    input:
        ancient(rules.combine.output.fasta),
    output:
        IDX / "bt2" / "{host}" / "{hkey}" / "index_done.txt",
    threads: 32
    resources:
        mem_mb=300000,
    shell:
        logged("bowtie2",
        r"""
        d=$(dirname {output})
        bowtie2-build --large-index --threads {threads} {input} "$d/{wildcards.host}" > "$d/build.log" 2>&1
        for p in 1 2 3 4 rev.1 rev.2; do test -s "$d/{wildcards.host}.$p.bt2l"; done
        echo "bowtie2 index of {input} built $(date -Is) with $(bowtie2-build --version | head -n 1)" > {output}
        """)


rule minimap2_index:
    conda:
        "envs/boardercollie.yaml"
    # ancient: a caller's reference_out is a hard link of this FASTA, and Snakemake
    # touches every output after a job, so each caller run bumps this file's mtime.
    # The index belongs to the host key (genomes and settings), not to that mtime;
    # without ancient every later caller would rebuild the shared index. A rerun of
    # combine itself still reruns this step.
    input:
        ancient(rules.combine.output.fasta),
    output:
        IDX / "minimap2" / "{host}" / "{hkey}" / "{host}.map-ont.mmi",
    threads: 16
    resources:
        mem_mb=120000,
    shell:
        logged("minimap2_index",
        "minimap2 -x map-ont -I 16G -t {threads} -d {output} {input} 2> {output}.log")


# Hosts with reference_out: the joined host reference also goes to that fixed path
# (a hard link, or a copy when the path is on another file system), with its
# members.tsv beside it, so a calling workflow (MAGmaker's host_filter genome) can
# name the file before the run. One step per host, since each path is given in full.
for _h in CFG.hosts:
    if not _h.reference_out:
        continue

    rule:
        name:
            "reference_out_" + re.sub(r"[^A-Za-z0-9_]", "_", _h.name)
        input:
            # ancient: the output is a hard link of this file, and Snakemake touches
            # outputs after a job, so every other caller's reference_out moves this
            # file's mtime past this caller's members.tsv copy. Without ancient that
            # reran this step in every earlier caller, and with it everything the
            # caller built from the reference (MAGmaker: host filtering of every sample).
            fasta=ancient(LIB / "hosts" / _h.name / host_key(_h) / f"{_h.name}.fna"),
            members=LIB / "hosts" / _h.name / host_key(_h) / "members.tsv",
            report=LIB / "hosts" / _h.name / host_key(_h) / "contamination_report.tsv",
        output:
            fasta=_h.reference_out,
            members=_h.reference_out + ".members.tsv",
        conda:
            "envs/boardercollie.yaml"
        shell:
            logged("reference_out",
            "ln -f {input.fasta} {output.fasta} 2>/dev/null || cp {input.fasta} {output.fasta}\n"
            "cp {input.members} {output.members}")


# Hosts with bowtie2_out / minimap2_out: the host's indexes, built once per host key in
# index_dir and shared by every caller, are also linked to fixed paths the calling
# workflow names before the run (a hard link, or a copy on another file system). A
# second workflow with the same host reuses the shared index instead of building its own.
for _h in CFG.hosts:
    _safe = re.sub(r"[^A-Za-z0-9_]", "_", _h.name)
    if _h.bowtie2_out:

        rule:
            name:
                "bowtie2_out_" + _safe
            input:
                IDX / "bt2" / _h.name / host_key(_h) / "index_done.txt",
            output:
                _h.bowtie2_out + ".index_done.txt",
            params:
                src=str(IDX / "bt2" / _h.name / host_key(_h) / _h.name),
                dst=_h.bowtie2_out,
            conda:
                "envs/boardercollie.yaml"
            shell:
                logged("bowtie2_out",
                r"""
                for p in 1 2 3 4 rev.1 rev.2; do
                  ln -f {params.src}.$p.bt2l {params.dst}.$p.bt2l 2>/dev/null || cp {params.src}.$p.bt2l {params.dst}.$p.bt2l
                done
                {{ printf 'shared_index\t%s\n' {params.src}; cat {input}; }} > {output}
                """)

    if _h.minimap2_out:

        rule:
            name:
                "minimap2_out_" + _safe
            input:
                IDX / "minimap2" / _h.name / host_key(_h) / f"{_h.name}.map-ont.mmi",
            output:
                _h.minimap2_out,
            conda:
                "envs/boardercollie.yaml"
            shell:
                logged("minimap2_out",
                "ln -f {input} {output} 2>/dev/null || cp {input} {output}")
